; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="goedwareJam"
run/main_scene="uid://jj2rgvx3uc6l"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AreaLimitController="*uid://b3d72tmjkb7qm"
PlayerController="*uid://c3u0223yf4p7j"
SceneTransition="*uid://clbgp1ptmcgur"
PlayerHud="*uid://dtaip2ryfph8v"
TimeController="*uid://b017lbvydhgc4"
SaveController="*uid://bdvgly680lym6"
PauseMenu="*uid://b51051t82slj1"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/coldrock-csv/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg")

